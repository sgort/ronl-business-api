# Vitest's default mode is 'test', not 'development' — so .env.development
# is never loaded for `npm test`. Without this file, isPaMock()'s build-time
# default (PA_MOCK_DEFAULT, read from import.meta.env at module load) would
# be false under test, even though every real build mode forces it true.
# mock-lock.test.ts's "no key set" case relies on that default holding here
# too. See task-8-report.md, "One deviation from the brief: .env.test".
VITE_SITE_URL=http://localhost:5176
VITE_PA_DOSSIERS_MOCK=true
VITE_PA_SIGNALS_MOCK=true
VITE_PA_AGENDA_MOCK=true
