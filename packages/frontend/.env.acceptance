VITE_API_URL=https://acc.api.open-regels.nl/v1
VITE_KEYCLOAK_URL=https://acc.keycloak.open-regels.nl
VITE_LDE_API_URL=https://acc.backend.linkeddata.open-regels.nl/v1
VITE_PA_SIGNALS_MOCK=false
VITE_PA_DOSSIERS_MOCK=false
VITE_PA_AGENDA_MOCK=false

# Link preview (Open Graph / Twitter) tags in index.html, filled at build time.
# Quoted prefix: an unquoted value would lose its trailing space.
VITE_SITE_URL=https://acc.mijn.open-regels.nl
VITE_OG_IMAGE=og-image-acc.png
VITE_OG_TITLE_PREFIX="[ACC] "
VITE_ROBOTS=noindex, nofollow
