VITE_API_URL=https://api.open-regels.nl/v1
VITE_STAFF_APP_URL=https://mijn.open-regels.nl

# The site's own public origin, shown in the footer.
VITE_SITE_URL=https://publiek.open-regels.nl

# Link preview (Open Graph / Twitter) and robots tags in index.html, filled
# at build time; prerender.ts also reads VITE_ROBOTS to write robots.txt.
# Quoted prefix: an unquoted value would lose its trailing space.
VITE_OG_TITLE_PREFIX=""
VITE_ROBOTS=index, follow
