        <di:waypoint x="300" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_OrganiserenInterneSchouw_Gateway_SchouwType_di" bpmnElement="Flow_Task_OrganiserenInterneSchouw_Gateway_SchouwType">
        <di:waypoint x="400" y="320" />
        <di:waypoint x="460" y="320" />
      </bpmndi:BPMNEdge>
