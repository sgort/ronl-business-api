<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:ronl="http://ronl.nl/schema/1.0" id="Definitions_RipR53Process" targetNamespace="http://example.com/rip-phase-53" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_RipR53Process">
    <bpmn:participant id="Participant_RipR53Process" name="R5.3 - (vervroegde) Ingebruikname / Oplevering" processRef="RipR53Process" />
  </bpmn:collaboration>
  <bpmn:process id="RipR53Process" name="R5.3 - (vervroegde) Ingebruikname / Oplevering" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_RipR53Process">
      <bpmn:lane id="Lane_Directievoerder" name="Directievoerder">
        <bpmn:flowNodeRef>StartEvent_R53</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrganiserenInterneSchouw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SchouwType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpleverschouwMetAannemer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VaststellenOpleveringschouw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OpleveringAkkoord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_R54_Oplevering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_R52_RestpuntenOplevering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IngebruiknameschouwMetAannemer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_VaststellenIngebruikname" name="Directievoerder, Toezichthouder, Aannemer">
        <bpmn:flowNodeRef>Task_VaststellenIngebruiknameschouw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IngebruiknameAkkoord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_R52_VervroegdeIngebruikname</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_R52_RestpuntenIngebruikname</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InterneSchouw" name="Directievoerder, Toezichthouder, Vestigingsmanager, Beheerder, Projectleider">
        <bpmn:flowNodeRef>Task_UitvoerenOpleverschouwIntern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UitvoerenIngebruiknameschouwIntern</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_R53" name="Start R5.3 - (vervroegde) Ingebruikname / Oplevering&#10;(vanuit R5.2 Werk gereed?)">
      <bpmn:outgoing>Flow_StartEvent_R53_Task_OrganiserenInterneSchouw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_OrganiserenInterneSchouw" name="Organiseren&#10;interne schouw" camunda:formRef="rip-organiseren-interne-schouw" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-directievoerder">
      <bpmn:incoming>Flow_StartEvent_R53_Task_OrganiserenInterneSchouw</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_OrganiserenInterneSchouw_Gateway_SchouwType</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SchouwType" name="Oplevering of (vervroegde)&#10;ingebruikname?">
      <bpmn:incoming>Flow_Task_OrganiserenInterneSchouw_Gateway_SchouwType</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_SchouwType_Task_UitvoerenOpleverschouwIntern</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_SchouwType_Task_UitvoerenIngebruiknameschouwIntern</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UitvoerenOpleverschouwIntern" name="Uitvoeren&#10;opleverschouw intern" camunda:formRef="rip-uitvoeren-opleverschouw-intern" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-directievoerder,rip-toezichthouder,rip-vestigingsmanager,rip-beheerder,rip-projectleider" ronl:documentRef="rip-bevindingen-opleverschouw">
      <bpmn:incoming>Flow_Gateway_SchouwType_Task_UitvoerenOpleverschouwIntern</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_UitvoerenOpleverschouwIntern_Task_OpleverschouwMetAannemer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OpleverschouwMetAannemer" name="Organiseren en uitvoeren opleverschouw&#10;met aannemer en tzh" camunda:formRef="rip-opleverschouw-aannemer" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-directievoerder" ronl:documentRef="rip-opleveringschouw">
      <bpmn:incoming>Flow_Task_UitvoerenOpleverschouwIntern_Task_OpleverschouwMetAannemer</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_OpleverschouwMetAannemer_Task_VaststellenOpleveringschouw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VaststellenOpleveringschouw" name="Vaststellen Opleveringschouw&#10;door dv en aannemer" camunda:formRef="rip-vaststellen-opleveringschouw" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-directievoerder" ronl:documentRef="rip-opleveringschouw-vastgesteld">
      <bpmn:incoming>Flow_Task_OpleverschouwMetAannemer_Task_VaststellenOpleveringschouw</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_VaststellenOpleveringschouw_Gateway_OpleveringAkkoord</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OpleveringAkkoord" name="Oplevering&#10;akkoord?">
      <bpmn:incoming>Flow_Task_VaststellenOpleveringschouw_Gateway_OpleveringAkkoord</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_OpleveringAkkoord_EndEvent_R54_Oplevering</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_OpleveringAkkoord_EndEvent_R52_RestpuntenOplevering</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_R54_Oplevering" name="Ja, oplevering areaal&#10;→ R5.4 Oplevering en onderhoudsperiode">
      <bpmn:incoming>Flow_Gateway_OpleveringAkkoord_EndEvent_R54_Oplevering</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_R52_RestpuntenOplevering" name="Nee, restpunten uitvoeren&#10;→ R5.2 Start werk &quot;buiten&quot;">
      <bpmn:incoming>Flow_Gateway_OpleveringAkkoord_EndEvent_R52_RestpuntenOplevering</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_UitvoerenIngebruiknameschouwIntern" name="Uitvoeren&#10;ingebruiknameschouw intern" camunda:formRef="rip-uitvoeren-ingebruiknameschouw-intern" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-directievoerder,rip-toezichthouder,rip-vestigingsmanager,rip-beheerder,rip-projectleider" ronl:documentRef="rip-bevindingen-ingebruiknameschouw">
      <bpmn:incoming>Flow_Gateway_SchouwType_Task_UitvoerenIngebruiknameschouwIntern</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_UitvoerenIngebruiknameschouwIntern_Task_IngebruiknameschouwMetAannemer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_IngebruiknameschouwMetAannemer" name="Organiseren en uitvoeren ingebruikname-&#10;schouw met aannemer en tzh" camunda:formRef="rip-ingebruiknameschouw-aannemer" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-directievoerder" ronl:documentRef="rip-ingebruiknameschouw">
      <bpmn:incoming>Flow_Task_UitvoerenIngebruiknameschouwIntern_Task_IngebruiknameschouwMetAannemer</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_IngebruiknameschouwMetAannemer_Task_VaststellenIngebruiknameschouw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VaststellenIngebruiknameschouw" name="Vaststellen Ingebruiknameschouw&#10;incl. restpuntenlijst" camunda:formRef="rip-vaststellen-ingebruiknameschouw" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-directievoerder,rip-toezichthouder,rip-opdrachtnemer" ronl:documentRef="rip-ingebruiknameschouw-vastgesteld">
      <bpmn:incoming>Flow_Task_IngebruiknameschouwMetAannemer_Task_VaststellenIngebruiknameschouw</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_VaststellenIngebruiknameschouw_Gateway_IngebruiknameAkkoord</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_IngebruiknameAkkoord" name="Akkoord (vervroegde)&#10;ingebruikname?">
      <bpmn:incoming>Flow_Task_VaststellenIngebruiknameschouw_Gateway_IngebruiknameAkkoord</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_IngebruiknameAkkoord_EndEvent_R52_VervroegdeIngebruikname</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_IngebruiknameAkkoord_EndEvent_R52_RestpuntenIngebruikname</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_R52_VervroegdeIngebruikname" name="Ja, vervroegde ingebruikname&#10;→ R5.2 Start werk &quot;buiten&quot;">
      <bpmn:incoming>Flow_Gateway_IngebruiknameAkkoord_EndEvent_R52_VervroegdeIngebruikname</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_R52_RestpuntenIngebruikname" name="Nee, restpunten uitvoeren door ON&#10;→ R5.2 Start werk &quot;buiten&quot;">
      <bpmn:incoming>Flow_Gateway_IngebruiknameAkkoord_EndEvent_R52_RestpuntenIngebruikname</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartEvent_R53_Task_OrganiserenInterneSchouw" sourceRef="StartEvent_R53" targetRef="Task_OrganiserenInterneSchouw" />
    <bpmn:sequenceFlow id="Flow_Task_OrganiserenInterneSchouw_Gateway_SchouwType" sourceRef="Task_OrganiserenInterneSchouw" targetRef="Gateway_SchouwType" />
    <bpmn:sequenceFlow id="Flow_Gateway_SchouwType_Task_UitvoerenOpleverschouwIntern" name="Oplevering" sourceRef="Gateway_SchouwType" targetRef="Task_UitvoerenOpleverschouwIntern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${schouwType == "oplevering"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_SchouwType_Task_UitvoerenIngebruiknameschouwIntern" name="(vervroegde) Ingebruikname" sourceRef="Gateway_SchouwType" targetRef="Task_UitvoerenIngebruiknameschouwIntern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${schouwType == "ingebruikname"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_UitvoerenOpleverschouwIntern_Task_OpleverschouwMetAannemer" sourceRef="Task_UitvoerenOpleverschouwIntern" targetRef="Task_OpleverschouwMetAannemer" />
    <bpmn:sequenceFlow id="Flow_Task_OpleverschouwMetAannemer_Task_VaststellenOpleveringschouw" sourceRef="Task_OpleverschouwMetAannemer" targetRef="Task_VaststellenOpleveringschouw" />
    <bpmn:sequenceFlow id="Flow_Task_VaststellenOpleveringschouw_Gateway_OpleveringAkkoord" sourceRef="Task_VaststellenOpleveringschouw" targetRef="Gateway_OpleveringAkkoord" />
    <bpmn:sequenceFlow id="Flow_Gateway_OpleveringAkkoord_EndEvent_R54_Oplevering" name="ja, oplevering areaal" sourceRef="Gateway_OpleveringAkkoord" targetRef="EndEvent_R54_Oplevering">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${opleveringAkkoord == "ja"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_OpleveringAkkoord_EndEvent_R52_RestpuntenOplevering" name="nee, restpunten uitvoeren" sourceRef="Gateway_OpleveringAkkoord" targetRef="EndEvent_R52_RestpuntenOplevering">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${opleveringAkkoord == "nee"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_UitvoerenIngebruiknameschouwIntern_Task_IngebruiknameschouwMetAannemer" sourceRef="Task_UitvoerenIngebruiknameschouwIntern" targetRef="Task_IngebruiknameschouwMetAannemer" />
    <bpmn:sequenceFlow id="Flow_Task_IngebruiknameschouwMetAannemer_Task_VaststellenIngebruiknameschouw" sourceRef="Task_IngebruiknameschouwMetAannemer" targetRef="Task_VaststellenIngebruiknameschouw" />
    <bpmn:sequenceFlow id="Flow_Task_VaststellenIngebruiknameschouw_Gateway_IngebruiknameAkkoord" sourceRef="Task_VaststellenIngebruiknameschouw" targetRef="Gateway_IngebruiknameAkkoord" />
    <bpmn:sequenceFlow id="Flow_Gateway_IngebruiknameAkkoord_EndEvent_R52_VervroegdeIngebruikname" name="ja, vervroegde ingebruikname" sourceRef="Gateway_IngebruiknameAkkoord" targetRef="EndEvent_R52_VervroegdeIngebruikname">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ingebruiknameAkkoord == "ja"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_IngebruiknameAkkoord_EndEvent_R52_RestpuntenIngebruikname" name="nee, restpunten door ON" sourceRef="Gateway_IngebruiknameAkkoord" targetRef="EndEvent_R52_RestpuntenIngebruikname">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ingebruiknameAkkoord == "nee"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:textAnnotation id="Annotation_R52_Entry">
      <bpmn:text>R5.2 Werk gereed? — R5.3 begint zodra de directievoerder het werk gereed meldt</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_R52_Entry" sourceRef="Task_OrganiserenInterneSchouw" targetRef="Annotation_R52_Entry" />
    <bpmn:textAnnotation id="Annotation_Bestek">
      <bpmn:text>Beide interne schouwen toetsen tegen het bestek (incl. bijlagen) en leggen hun bevindingen vast op het sjabloon schouwrapport.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_Bestek" sourceRef="Task_UitvoerenOpleverschouwIntern" targetRef="Annotation_Bestek" />
    <bpmn:textAnnotation id="Annotation_Exits">
      <bpmn:text>Drie van de vier uitgangen keren terug naar R5.2, om drie verschillende redenen. Alleen een akkoord bevonden oplevering gaat door naar R5.4.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_Exits" sourceRef="Gateway_IngebruiknameAkkoord" targetRef="Annotation_Exits" />
  </bpmn:process>

