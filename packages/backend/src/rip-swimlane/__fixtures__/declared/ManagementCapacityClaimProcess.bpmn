<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:ronl="http://ronl.nl/schema/1.0" id="Definitions_ManagementCapacityClaimProcess" targetNamespace="http://example.com/hr-capacity" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_CapacityClaim">
    <bpmn:participant id="Participant_CapacityClaim" name="Beheer capaciteitsclaim — proces" processRef="ManagementCapacityClaimProcess" />
  </bpmn:collaboration>
  <bpmn:process id="ManagementCapacityClaimProcess" name="Beheer capaciteitsclaim — proces" ronl:language="nl" ronl:organization="flevoland" ronl:phases="intake:Intake;claim:Claim opstellen;routering:Routering;agenda:Agendering;besluit:Directiebesluit;heroverweging:Heroverweging;overdracht:Overdracht;reservering:Financiële reservering" ronl:phaseLabel="Fase" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_CapacityClaim">
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>StartEvent_CapacityClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultAndClassify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RequestType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareStaffingClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareHiringClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePrepare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Systeem" name="Systeem">
        <bpmn:flowNodeRef>Task_DetermineRouting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MapRoutingOutputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResetClaimFields</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Directiesecretaris" name="Directiesecretaris">
        <bpmn:flowNodeRef>Task_SubmitToBoardAgenda</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Directie" name="Directie">
        <bpmn:flowNodeRef>Task_BoardDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BoardDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionRoute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager_HRBP_Personeelscontroller" name="Manager, HR-businesspartner, Personeelscontroller">
        <bpmn:flowNodeRef>Task_ReconsiderationMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReconsiderationOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HRMUnit" name="HRM-unit">
        <bpmn:flowNodeRef>Task_HandoverToRecruitment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Inkoop_PlanningControl" name="Inkoop, Planning &amp; control">
        <bpmn:flowNodeRef>Task_HandoverToProcurement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FinancieelController" name="Financieel controller">
        <bpmn:flowNodeRef>Gateway_MergeHandover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterReservation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClaimCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_CapacityClaim" name="Start capaciteitsclaim" ronl:phase="intake">
      <bpmn:outgoing>Flow_Start_Intake</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ConsultAndClassify" name="Overleggen en classificeren" camunda:formRef="capacity-claim-intake-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="manager">
      <bpmn:incoming>Flow_Start_Intake</bpmn:incoming>
      <bpmn:outgoing>Flow_Intake_RequestTypeGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RequestType" name="Type aanvraag?" ronl:phase="claim">
      <bpmn:incoming>Flow_Intake_RequestTypeGateway</bpmn:incoming>
      <bpmn:incoming>Flow_ResetClaim_RequestTypeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Staffing</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Hiring</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PrepareStaffingClaim" name="Formatieclaim opstellen" camunda:formRef="capacity-claim-staffing-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="manager">
      <bpmn:incoming>Flow_Gateway_Staffing</bpmn:incoming>
      <bpmn:outgoing>Flow_Staffing_MergePrepare</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PrepareHiringClaim" name="Inhuurclaim opstellen" camunda:formRef="capacity-claim-hiring-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="manager">
      <bpmn:incoming>Flow_Gateway_Hiring</bpmn:incoming>
      <bpmn:outgoing>Flow_Hiring_MergePrepare</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergePrepare" name="">
      <bpmn:incoming>Flow_Staffing_MergePrepare</bpmn:incoming>
      <bpmn:incoming>Flow_Hiring_MergePrepare</bpmn:incoming>
      <bpmn:outgoing>Flow_MergePrepare_Routing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_DetermineRouting" name="Routering bepalen" ronl:phase="routering" camunda:resultVariable="routingResult" camunda:decisionRef="CapacityClaimRouting" camunda:decisionRefTenantId="${null}" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_MergePrepare_Routing</bpmn:incoming>
      <bpmn:outgoing>Flow_Routing_MapOutputs</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Task_MapRoutingOutputs" name="Routering-uitkomsten mappen" scriptFormat="javascript">
      <bpmn:incoming>Flow_Routing_MapOutputs</bpmn:incoming>
      <bpmn:outgoing>Flow_MapOutputs_Submit</bpmn:outgoing>
      <bpmn:script>
        execution.setVariable("decisionRoute",   routingResult.get("decisionRoute"));
        execution.setVariable("candidateGroups", routingResult.get("candidateGroups"));
        execution.setVariable("advisoryGroup",   routingResult.get("advisoryGroup"));
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_SubmitToBoardAgenda" name="Agenderen Directievergadering" ronl:phase="agenda" camunda:formRef="capacity-claim-submit-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="board-secretary">
      <bpmn:incoming>Flow_MapOutputs_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_BoardDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BoardDecision" name="Directiebesluit" ronl:phase="besluit" camunda:formRef="capacity-claim-board-decision-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="board-director" ronl:documentRef="board-decision-notification-nl">
      <bpmn:incoming>Flow_Submit_BoardDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_BoardDecision_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_BoardDecision" name="Directiebesluit?">
      <bpmn:incoming>Flow_BoardDecision_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReconsiderationMeeting" name="Heroverwegingsoverleg" ronl:phase="heroverweging" camunda:formRef="capacity-claim-reconsideration-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="manager,hr-business-partner,personnel-controller">
      <bpmn:incoming>Flow_Gateway_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Reconsider_OutcomeGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReconsiderationOutcome" name="Uitkomst heroverweging?">
      <bpmn:incoming>Flow_Reconsider_OutcomeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Reconsider_BackToRequestType</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reconsider_Withdraw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Withdrawn" name="Ingetrokken">
      <bpmn:incoming>Flow_Reconsider_Withdraw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_DecisionRoute" name="Route?" ronl:phase="overdracht">
      <bpmn:incoming>Flow_Gateway_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Recruitment</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Procurement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HandoverToRecruitment" name="Overdracht naar werving &amp; selectie" camunda:formRef="capacity-claim-handover-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="hrm-unit" ronl:documentRef="capacity-claim-handover-nl">
      <bpmn:incoming>Flow_Route_Recruitment</bpmn:incoming>
      <bpmn:outgoing>Flow_Recruitment_MergeHandover</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HandoverToProcurement" name="Overdracht naar inkoop" camunda:formRef="capacity-claim-handover-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="procurement-unit,planning-control-officer" ronl:documentRef="capacity-claim-handover-nl">
      <bpmn:incoming>Flow_Route_Procurement</bpmn:incoming>
      <bpmn:outgoing>Flow_Procurement_MergeHandover</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeHandover" name="" ronl:phase="reservering">
      <bpmn:incoming>Flow_Recruitment_MergeHandover</bpmn:incoming>
      <bpmn:incoming>Flow_Procurement_MergeHandover</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeHandover_Reservation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RegisterReservation" name="Financiële reservering registreren" camunda:formRef="capacity-claim-register-reservation-nl" camunda:formRefBinding="deployment" camunda:candidateGroups="financial-controller">
      <bpmn:incoming>Flow_MergeHandover_Reservation</bpmn:incoming>
      <bpmn:outgoing>Flow_Reservation_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ClaimCompleted" name="Capaciteitsclaim afgerond">
      <bpmn:incoming>Flow_Reservation_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Intake" sourceRef="StartEvent_CapacityClaim" targetRef="Task_ConsultAndClassify" />
    <bpmn:sequenceFlow id="Flow_Intake_RequestTypeGateway" sourceRef="Task_ConsultAndClassify" targetRef="Gateway_RequestType" />
    <bpmn:sequenceFlow id="Flow_Gateway_Staffing" name="formatie" sourceRef="Gateway_RequestType" targetRef="Task_PrepareStaffingClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requestType == "staffing"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Hiring" name="inhuur" sourceRef="Gateway_RequestType" targetRef="Task_PrepareHiringClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requestType == "hiring"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Staffing_MergePrepare" sourceRef="Task_PrepareStaffingClaim" targetRef="Gateway_MergePrepare" />
    <bpmn:sequenceFlow id="Flow_Hiring_MergePrepare" sourceRef="Task_PrepareHiringClaim" targetRef="Gateway_MergePrepare" />
    <bpmn:sequenceFlow id="Flow_MergePrepare_Routing" sourceRef="Gateway_MergePrepare" targetRef="Task_DetermineRouting" />
    <bpmn:sequenceFlow id="Flow_Routing_MapOutputs" sourceRef="Task_DetermineRouting" targetRef="Task_MapRoutingOutputs" />
    <bpmn:sequenceFlow id="Flow_MapOutputs_Submit" sourceRef="Task_MapRoutingOutputs" targetRef="Task_SubmitToBoardAgenda" />
    <bpmn:sequenceFlow id="Flow_Submit_BoardDecision" sourceRef="Task_SubmitToBoardAgenda" targetRef="Task_BoardDecision" />
    <bpmn:sequenceFlow id="Flow_BoardDecision_Gateway" sourceRef="Task_BoardDecision" targetRef="Gateway_BoardDecision" />
    <bpmn:sequenceFlow id="Flow_Gateway_Approved" name="akkoord" sourceRef="Gateway_BoardDecision" targetRef="Gateway_DecisionRoute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${boardDecision == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Rejected" name="afgewezen" sourceRef="Gateway_BoardDecision" targetRef="Task_ReconsiderationMeeting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${boardDecision == "rejected"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reconsider_OutcomeGateway" sourceRef="Task_ReconsiderationMeeting" targetRef="Gateway_ReconsiderationOutcome" />
    <bpmn:sequenceFlow id="Flow_Reconsider_BackToRequestType" name="doorgaan" sourceRef="Gateway_ReconsiderationOutcome" targetRef="Task_ResetClaimFields">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reconsiderationOutcome == "proceed"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:scriptTask id="Task_ResetClaimFields" name="Claimvelden resetten" scriptFormat="javascript">
      <bpmn:incoming>Flow_Reconsider_BackToRequestType</bpmn:incoming>
      <bpmn:outgoing>Flow_ResetClaim_RequestTypeGateway</bpmn:outgoing>
      <bpmn:script>
        // On the proceed-with-revision path, clear all claim-type-specific variables
        // before re-entering Gateway_RequestType. This prevents ghost data (e.g. old
        // staffing fields lingering when the manager switches to hiring) from ending
        // up in process variables or in the capacity-claim-handover document.
        var claimFields = [
          // Shared claim details
          "description", "functionCode", "jobTitle", "startDate", "endDate",
          "hoursMin", "hoursMax", "costsYearToDate", "annualCostsAfter",
          "fundingSource", "hrmAdvice",
          // Staffing-only
          "appointmentType", "fteMin", "fteMax", "scale", "employmentConditionChanges",
          // Hiring-only
          "durationMonths", "extensionStartDate", "extensionEndDate", "extensionMonths",
          "hourlyWageMin", "hourlyWageMax", "procurementPolicyDeviationReason",
          // Routing (hoisted DMN outputs — will be recomputed on the next pass)
          "decisionRoute", "candidateGroups", "advisoryGroup",
          // Board submission + decision
          "scheduledMeetingDate", "submittedBy", "submissionNotes",
          "boardDecision", "decisionConditions", "rejectionReason",
          "decisionDate", "boardMinuteReference"
        ];
        for (var i = 0; i &lt; claimFields.length; i++) {
          execution.removeVariable(claimFields[i]);
        }
        // Apply the revised request type chosen in the reconsideration meeting,
        // so Gateway_RequestType routes to staffing or hiring correctly.
        if (typeof revisedRequestType !== "undefined" &amp;&amp; revisedRequestType !== null) {
          execution.setVariable("requestType", revisedRequestType);
        }
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ResetClaim_RequestTypeGateway" sourceRef="Task_ResetClaimFields" targetRef="Gateway_RequestType" />
    <bpmn:sequenceFlow id="Flow_Reconsider_Withdraw" name="withdraw" sourceRef="Gateway_ReconsiderationOutcome" targetRef="EndEvent_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reconsiderationOutcome == "withdraw"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_Recruitment" name="werving &amp; selectie" sourceRef="Gateway_DecisionRoute" targetRef="Task_HandoverToRecruitment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionRoute == "recruitment"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_Procurement" name="inhuur" sourceRef="Gateway_DecisionRoute" targetRef="Task_HandoverToProcurement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionRoute == "procurement"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Recruitment_MergeHandover" sourceRef="Task_HandoverToRecruitment" targetRef="Gateway_MergeHandover" />
    <bpmn:sequenceFlow id="Flow_Procurement_MergeHandover" sourceRef="Task_HandoverToProcurement" targetRef="Gateway_MergeHandover" />
    <bpmn:sequenceFlow id="Flow_MergeHandover_Reservation" sourceRef="Gateway_MergeHandover" targetRef="Task_RegisterReservation" />
    <bpmn:sequenceFlow id="Flow_Reservation_End" sourceRef="Task_RegisterReservation" targetRef="EndEvent_ClaimCompleted" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ManagementCapacityClaim">
    <bpmndi:BPMNPlane id="BPMNPlane_ManagementCapacityClaim" bpmnElement="Collaboration_CapacityClaim">
      <bpmndi:BPMNShape id="Participant_CapacityClaim_di" bpmnElement="Participant_CapacityClaim" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="2680" height="1260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="2650" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Systeem_di" bpmnElement="Lane_Systeem" isHorizontal="true">
        <dc:Bounds x="130" y="340" width="2650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Directiesecretaris_di" bpmnElement="Lane_Directiesecretaris" isHorizontal="true">
        <dc:Bounds x="130" y="480" width="2650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Directie_di" bpmnElement="Lane_Directie" isHorizontal="true">
        <dc:Bounds x="130" y="620" width="2650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_HRBP_Personeelscontroller_di" bpmnElement="Lane_Manager_HRBP_Personeelscontroller" isHorizontal="true">
        <dc:Bounds x="130" y="760" width="2650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HRMUnit_di" bpmnElement="Lane_HRMUnit" isHorizontal="true">
        <dc:Bounds x="130" y="900" width="2650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Inkoop_PlanningControl_di" bpmnElement="Lane_Inkoop_PlanningControl" isHorizontal="true">
        <dc:Bounds x="130" y="1040" width="2650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_FinancieelController_di" bpmnElement="Lane_FinancieelController" isHorizontal="true">
        <dc:Bounds x="130" y="1180" width="2650" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_CapacityClaim_di" bpmnElement="StartEvent_CapacityClaim">
        <dc:Bounds x="192" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="175" y="225" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultAndClassify_di" bpmnElement="Task_ConsultAndClassify">
        <dc:Bounds x="270" y="160" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RequestType_di" bpmnElement="Gateway_RequestType" isMarkerVisible="true">
        <dc:Bounds x="485" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="150" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareStaffingClaim_di" bpmnElement="Task_PrepareStaffingClaim">
        <dc:Bounds x="570" y="70" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareHiringClaim_di" bpmnElement="Task_PrepareHiringClaim">
        <dc:Bounds x="570" y="250" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergePrepare_di" bpmnElement="Gateway_MergePrepare" isMarkerVisible="true">
        <dc:Bounds x="785" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetermineRouting_di" bpmnElement="Task_DetermineRouting">
        <dc:Bounds x="870" y="370" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MapRoutingOutputs_di" bpmnElement="Task_MapRoutingOutputs">
        <dc:Bounds x="1080" y="370" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResetClaimFields_di" bpmnElement="Task_ResetClaimFields">
        <dc:Bounds x="330" y="370" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitToBoardAgenda_di" bpmnElement="Task_SubmitToBoardAgenda">
        <dc:Bounds x="1500" y="510" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BoardDecision_di" bpmnElement="Task_BoardDecision">
        <dc:Bounds x="1710" y="650" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_BoardDecision_di" bpmnElement="Gateway_BoardDecision" isMarkerVisible="true">
        <dc:Bounds x="1925" y="665" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1915" y="640" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DecisionRoute_di" bpmnElement="Gateway_DecisionRoute" isMarkerVisible="true">
        <dc:Bounds x="2035" y="665" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2042" y="640" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReconsiderationMeeting_di" bpmnElement="Task_ReconsiderationMeeting">
        <dc:Bounds x="1710" y="790" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReconsiderationOutcome_di" bpmnElement="Gateway_ReconsiderationOutcome" isMarkerVisible="true">
        <dc:Bounds x="1595" y="805" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1580" y="860" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Withdrawn_di" bpmnElement="EndEvent_Withdrawn">
