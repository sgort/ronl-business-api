    <bpmn:textAnnotation id="Annotation_JoinTerugkeer">
      <bpmn:text>Alle vijf takken keren hier terug. De PDF toont dat Inventariseren kabels en leidingen en Aanvragen raamvergunning de pool verlaten zonder terugkeer; letterlijk gemodelleerd blokkeert deze join. De terugkeer is toegevoegd om het proces uitvoerbaar te maken.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_JoinTerugkeer" sourceRef="Gateway_UitgangspuntenJoin" targetRef="Annotation_JoinTerugkeer" />
  </bpmn:process>
