    <bpmn:sequenceFlow id="Flow_Task_VerzamelenKlanteisen_Gateway_UitgangspuntenJoin" sourceRef="Task_VerzamelenKlanteisen" targetRef="Gateway_UitgangspuntenJoin" />
    <bpmn:sequenceFlow id="Flow_Task_InventariserenKabelsLeidingen_Gateway_UitgangspuntenJoin" sourceRef="Task_InventariserenKabelsLeidingen" targetRef="Gateway_UitgangspuntenJoin" />
