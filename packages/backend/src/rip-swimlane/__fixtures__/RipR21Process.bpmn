<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:ronl="http://ronl.nl/schema/1.0" id="Definitions_RipPhase1" targetNamespace="http://example.com/rip-phase1" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_RipPhase1">
    <bpmn:participant id="Participant_RipPhase1" name="RIP Fase 1 — R2.1 Projectplan Planvoorbereiding" processRef="RipR21Process" />
  </bpmn:collaboration>
  <bpmn:process id="RipR21Process" name="RIP Fase 1 — R2.1 Projectplan Planvoorbereiding" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PL_Aandrager_AO" name="Projectleider, Aandrager, AO">
        <bpmn:flowNodeRef>Task_AccorderenProjectplan4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Akkoord4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Phase1Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RIPteam" name="RIP-team">
        <bpmn:flowNodeRef>Task_HoudenOverlegVO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Aandrager" name="Aandrager">
        <bpmn:flowNodeRef>StartEvent_RipPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AanlevrenProjectplan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerberenKwaliteit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DeelnemersPSU" name="Deelnemers PSU">
        <bpmn:flowNodeRef>Task_UitvoerenPSU</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Aandrager_PL" name="Aandrager, Projectleider">
        <bpmn:flowNodeRef>Task_AccorderenProjectplan2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Akkoord2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AO_Aandrager_PL" name="AO, Aandrager, Projectleider">
        <bpmn:flowNodeRef>Task_UitvoerenIntakeoverleg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IntakeAkkoord</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Projectondersteuner" name="Projectondersteuner">
        <bpmn:flowNodeRef>Task_AanmakenWorkspaceRelatics</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Projectleider" name="Projectleider">
        <bpmn:flowNodeRef>Task_AanvullenProjectplan2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitierenPSU</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AanvullenProjectplan4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ManagerPB" name="Manager Projectbeheersing">
        <bpmn:flowNodeRef>Task_OrganiserenIntakeoverleg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpstellenRisicodossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpstellenPlanning</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_RipPhase1" name="Start RIP fase 1">
      <bpmn:outgoing>Flow_Start_Aanlevren</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AanlevrenProjectplan" name="Aanleveren Projectplan&#10;1. Intake-formulier" camunda:formRef="rip-intake" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-aandrager">
      <bpmn:incoming>Flow_Start_Aanlevren</bpmn:incoming>
      <bpmn:outgoing>Flow_Aanlevren_Organiseren</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerberenKwaliteit" name="Verbeteren kwaliteit&#10;1. Intake-formulier" camunda:formRef="rip-kwaliteit-verbetering" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-aandrager">
      <bpmn:incoming>Flow_IntakeNee_Verbeteren</bpmn:incoming>
      <bpmn:outgoing>Flow_Verbeteren_Accorderen2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OrganiserenIntakeoverleg" name="Organiseren intake-overleg" camunda:formRef="rip-intake-meeting" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-manager-pb">
      <bpmn:incoming>Flow_Aanlevren_Organiseren</bpmn:incoming>
      <bpmn:outgoing>Flow_Organiseren_Uitvoeren</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OpstellenRisicodossier" name="Opstellen risicossier&#10;en versturen aan PL" camunda:formRef="rip-risk-file" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-manager-pb">
      <bpmn:incoming>Flow_Relatics_Risicodossier</bpmn:incoming>
      <bpmn:outgoing>Flow_Risicodossier_UitvoerenPSU</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OpstellenPlanning" name="Opstellen planning en&#10;informeren PL en ondersteuner" camunda:formRef="rip-planning" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-manager-pb">
      <bpmn:incoming>Flow_UitvoerenPSU_Planning</bpmn:incoming>
      <bpmn:outgoing>Flow_Planning_Aanvullen4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AanvullenProjectplan2" name="Aanvullen Projectplan&#10;2. Intake-verslag" camunda:formRef="rip-intake-report" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-projectleider" ronl:documentRef="rip-intake-report">
      <bpmn:incoming>Flow_IntakeJa_Aanvullen2</bpmn:incoming>
      <bpmn:incoming>Flow_Akkoord2Rejected_Aanvullen2</bpmn:incoming>
      <bpmn:outgoing>Flow_Aanvullen2_Accorderen2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InitierenPSU" name="Initieren / organiseren PSU" camunda:formRef="rip-psu-organize" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-projectleider">
      <bpmn:incoming>Flow_Akkoord2Approved_InitierenPSU</bpmn:incoming>
      <bpmn:outgoing>Flow_InitierenPSU_Relatics</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AanvullenProjectplan4" name="Aanvullen Projectplan&#10;4. Uitgangspunten VO-fase" camunda:formRef="rip-pdp-aanvullen" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-projectleider" ronl:documentRef="rip-pdp">
      <bpmn:incoming>Flow_Planning_Aanvullen4</bpmn:incoming>
      <bpmn:incoming>Flow_Akkoord4Rejected_Aanvullen4</bpmn:incoming>
      <bpmn:outgoing>Flow_Aanvullen4_OverlegVO</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_AanmakenWorkspaceRelatics" name="Laten aanmaken&#10;workspace Relatics" camunda:type="external" camunda:topic="rip-relatics-workspace">
      <bpmn:incoming>Flow_InitierenPSU_Relatics</bpmn:incoming>
      <bpmn:outgoing>Flow_Relatics_Risicodossier</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_UitvoerenIntakeoverleg" name="Uitvoeren intake-overleg" camunda:formRef="rip-uitvoer-intake" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-ao,rip-aandrager,rip-projectleider">
      <bpmn:incoming>Flow_Organiseren_Uitvoeren</bpmn:incoming>
      <bpmn:outgoing>Flow_Uitvoeren_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_IntakeAkkoord" name="Projectplan 1.&#10;Intake-formulier akkoord?">
      <bpmn:incoming>Flow_Uitvoeren_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_IntakeJa_Aanvullen2</bpmn:outgoing>
      <bpmn:outgoing>Flow_IntakeNee_Verbeteren</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AccorderenProjectplan2" name="Accorderen Projectplan&#10;2. Intake-verslag" camunda:formRef="rip-approval" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-aandrager,rip-projectleider">
      <bpmn:incoming>Flow_Aanvullen2_Accorderen2</bpmn:incoming>
      <bpmn:incoming>Flow_Verbeteren_Accorderen2</bpmn:incoming>
      <bpmn:outgoing>Flow_Accorderen2_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Akkoord2" name="Akkoord?">
      <bpmn:incoming>Flow_Accorderen2_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Akkoord2Approved_InitierenPSU</bpmn:outgoing>
      <bpmn:outgoing>Flow_Akkoord2Rejected_Aanvullen2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UitvoerenPSU" name="Uitvoeren PSU en aanvullen&#10;Projectplan 3. PSU-verslag" camunda:formRef="rip-psu-execution" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-deelnemers-psu" ronl:documentRef="rip-psu-report">
      <bpmn:incoming>Flow_Risicodossier_UitvoerenPSU</bpmn:incoming>
      <bpmn:outgoing>Flow_UitvoerenPSU_Planning</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HoudenOverlegVO" name="Houden overleg&#10;uitgangspunten VO-fase" camunda:formRef="rip-overleg-vo" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-team">
      <bpmn:incoming>Flow_Aanvullen4_OverlegVO</bpmn:incoming>
      <bpmn:outgoing>Flow_OverlegVO_Accorderen4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AccorderenProjectplan4" name="Accorderen Projectplan&#10;4. Uitgangspunten VO-fase" camunda:formRef="rip-approval" camunda:formRefBinding="deployment" camunda:candidateGroups="rip-projectleider,rip-aandrager,rip-ao" ronl:signatureRef="rip-pdp">
      <bpmn:incoming>Flow_OverlegVO_Accorderen4</bpmn:incoming>
      <bpmn:outgoing>Flow_Accorderen4_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Akkoord4" name="Akkoord?">
      <bpmn:incoming>Flow_Accorderen4_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Akkoord4Approved_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_Akkoord4Rejected_Aanvullen4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Phase1Complete" name="Fase 1 voltooid&#10;→ R2.2">
      <bpmn:incoming>Flow_Akkoord4Approved_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Aanlevren" sourceRef="StartEvent_RipPhase1" targetRef="Task_AanlevrenProjectplan" />
    <bpmn:sequenceFlow id="Flow_Aanlevren_Organiseren" sourceRef="Task_AanlevrenProjectplan" targetRef="Task_OrganiserenIntakeoverleg" />
    <bpmn:sequenceFlow id="Flow_IntakeNee_Verbeteren" name="Nee" sourceRef="Gateway_IntakeAkkoord" targetRef="Task_VerberenKwaliteit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${intakeAkkoord == "nee"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verbeteren_Accorderen2" sourceRef="Task_VerberenKwaliteit" targetRef="Task_AccorderenProjectplan2" />
    <bpmn:sequenceFlow id="Flow_Organiseren_Uitvoeren" sourceRef="Task_OrganiserenIntakeoverleg" targetRef="Task_UitvoerenIntakeoverleg" />
    <bpmn:sequenceFlow id="Flow_Relatics_Risicodossier" sourceRef="Task_AanmakenWorkspaceRelatics" targetRef="Task_OpstellenRisicodossier" />
    <bpmn:sequenceFlow id="Flow_Risicodossier_UitvoerenPSU" sourceRef="Task_OpstellenRisicodossier" targetRef="Task_UitvoerenPSU" />
    <bpmn:sequenceFlow id="Flow_UitvoerenPSU_Planning" sourceRef="Task_UitvoerenPSU" targetRef="Task_OpstellenPlanning" />
    <bpmn:sequenceFlow id="Flow_Planning_Aanvullen4" sourceRef="Task_OpstellenPlanning" targetRef="Task_AanvullenProjectplan4" />
    <bpmn:sequenceFlow id="Flow_IntakeJa_Aanvullen2" name="Ja" sourceRef="Gateway_IntakeAkkoord" targetRef="Task_AanvullenProjectplan2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${intakeAkkoord == "ja"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Akkoord2Rejected_Aanvullen2" name="niet akkoord" sourceRef="Gateway_Akkoord2" targetRef="Task_AanvullenProjectplan2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalStatus == "rejected"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Aanvullen2_Accorderen2" sourceRef="Task_AanvullenProjectplan2" targetRef="Task_AccorderenProjectplan2" />
    <bpmn:sequenceFlow id="Flow_Akkoord2Approved_InitierenPSU" name="akkoord" sourceRef="Gateway_Akkoord2" targetRef="Task_InitierenPSU">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalStatus == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InitierenPSU_Relatics" sourceRef="Task_InitierenPSU" targetRef="Task_AanmakenWorkspaceRelatics" />
    <bpmn:sequenceFlow id="Flow_Akkoord4Rejected_Aanvullen4" name="niet akkoord" sourceRef="Gateway_Akkoord4" targetRef="Task_AanvullenProjectplan4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalStatus == "rejected"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Aanvullen4_OverlegVO" sourceRef="Task_AanvullenProjectplan4" targetRef="Task_HoudenOverlegVO" />
    <bpmn:sequenceFlow id="Flow_Uitvoeren_Gateway" sourceRef="Task_UitvoerenIntakeoverleg" targetRef="Gateway_IntakeAkkoord" />
    <bpmn:sequenceFlow id="Flow_Accorderen2_Gateway" sourceRef="Task_AccorderenProjectplan2" targetRef="Gateway_Akkoord2" />
    <bpmn:sequenceFlow id="Flow_OverlegVO_Accorderen4" sourceRef="Task_HoudenOverlegVO" targetRef="Task_AccorderenProjectplan4" />
    <bpmn:sequenceFlow id="Flow_Accorderen4_Gateway" sourceRef="Task_AccorderenProjectplan4" targetRef="Gateway_Akkoord4" />
    <bpmn:sequenceFlow id="Flow_Akkoord4Approved_End" name="akkoord" sourceRef="Gateway_Akkoord4" targetRef="EndEvent_Phase1Complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalStatus == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Annotation_E2EFixture">
      <bpmn:text>⚠️ E2E FIXTURE — source of truth: linked-data-explorer/e2e-fixtures/. Edits here diverge from ronl-business-api's E2E test suite. See e2e-fixtures/manifest.json.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_E2EFixture" sourceRef="Annotation_E2EFixture" targetRef="StartEvent_RipPhase1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_RipPhase1">
    <bpmndi:BPMNPlane id="BPMNPlane_RipPhase1" bpmnElement="Collaboration_RipPhase1">
