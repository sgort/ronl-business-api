      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AanmakenWorkspaceRelatics_di" bpmnElement="Task_AanmakenWorkspaceRelatics">
        <dc:Bounds x="1925" y="440" width="160" height="80" />
      </bpmndi:BPMNShape>
