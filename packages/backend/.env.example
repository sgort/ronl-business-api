# RONL Business API Configuration

# Server Configuration
NODE_ENV=development
PORT=3002
HOST=0.0.0.0
# Flevoland's network proxy intercepts HTTPS traffic and re-signs it with their own corporate CA certificate
# Node.js doesn't trust that CA by default, so every outbound HTTPS request — including the external task worker polling operaton.open-regels.nl — 
# fails with "unable to get local issuer certificate"
# 
# Proper fix: add the corporate CA to Node.js
NODE_EXTRA_CA_CERTS=C:\Users\gorts01\corporate-ca.pem
# Quick workaround: disable TLS verification for development only
NODE_TLS_REJECT_UNAUTHORIZED=0

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ronl
KEYCLOAK_CLIENT_ID=ronl-business-api
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Token Validation
JWT_ISSUER=http://localhost:8080/realms/ronl
JWT_AUDIENCE=ronl-business-api
TOKEN_CACHE_TTL=300

# Operaton BPMN Engine
OPERATON_BASE_URL=http://localhost:8081/engine-rest
OPERATON_TIMEOUT=30000
OPERATON_USERNAME=demo
OPERATON_PASSWORD=demo

# Operaton BPMN Engine specific for M2M operaton-mcp-client
OPERATON_M2M_BASE_URL=https://operaton-doc.open-regels.nl/engine-rest
OPERATON_TIMEOUT=30000
OPERATON_USERNAME=demo
OPERATON_PASSWORD=demo

# eDOCS
# Stub mode (default) returns fake data and never calls the DM server.
# Set to false to go live — see docs/EDOCS-GO-LIVE.md.
EDOCS_STUB_MODE=true
# API ROOT — the client appends connect/workspaces/documents/libraries.
# Use the root, NOT the login endpoint (no trailing /connect). Required when live.
EDOCS_BASE_URL=https://<host>:<port>/edocsapi/v1.0
EDOCS_LIBRARY=DOCUVITT
# Service-account credentials. Required when EDOCS_STUB_MODE=false.
EDOCS_USER_ID=
EDOCS_PASSWORD=

# Doccle (Sender Service v1, mci-rest-app — XML API)
# Stub mode (default) returns fake data and never calls the Doccle API.
DOCCLE_STUB_MODE=true
# API root, e.g. https://stg-webservice.doccle.be/mci-rest-app/rest/mci/external for staging.
DOCCLE_BASE_URL=
# Service-account credentials (HTTP Basic). Required when DOCCLE_STUB_MODE=false.
DOCCLE_USERNAME=
DOCCLE_PASSWORD=

# Database (Audit Logs)
DATABASE_URL=postgresql://audit_user:audit_password@localhost:5432/audit_logs
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_TENANT=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=7

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_INCLUDE_IP=true
AUDIT_LOG_RETENTION_DAYS=2555

# Security
HELMET_ENABLED=true
SECURE_COOKIES=false
TRUST_PROXY=false

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# Tenant Configuration
DEFAULT_MAX_PROCESS_INSTANCES=1000
ENABLE_TENANT_ISOLATION=true

# MCP Client (operaton-mcp)
MCP_ENABLED=true
MCP_SKIP_HEALTH_CHECK=false

# Anthropic (required when MCP_ENABLED=true)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# TriplyDB MCP provider (optional)
TRIPLYDB_MCP_ENABLED=true
TRIPLYDB_ENDPOINT=https://api.open-regels.triply.cc/datasets/stevengort/DMN-discovery/services/DMN-discovery/sparql
TRIPLYDB_TOKEN=

# CPRMV provider
CPRMV_MCP_ENABLED=true 

# LDE Assets provider
LDE_MCP_ENABLED=true
# ACC/PROD: separate Azure Database for PostgreSQL Flexible Server (isolated from RONL Business API)
# ?sslmode=require for Azure Database is handled by let pool in `packages/backend/src/mcp-servers/lde/index.ts`
# Local dev: reuse the existing ronl-postgres container 
LDE_DATABASE_URL=postgresql://lde_user:lde_password@localhost:5432/lde_assets

# Gitlab
GITLAB_TOKEN=glpat-…
GITLAB_BASE_URL=https://git.open-regels.nl
GITLAB_PROJECT_PATH=showcases%2Fiou-architectuur
GITLAB_UC_LABEL=Submitted

# ALTCHA (proof-of-work spam protection for public write endpoints)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALTCHA_HMAC_KEY=change-me-use-a-long-random-secret

# PA Monitoring — Tweede Kamer + Officiële Bekendmakingen + Europees Parlement + Media
# TK and OB use public APIs (no key needed). EU defaults to data.europarl.europa.eu.
EU_SOURCE_ENABLED=true
EP_TEXTS_SUBMITTED_ENABLED=true

# Media & omgeving — in-house nieuws-aggregator (GET /v1/media-aggregator/search)
# Same-process loopback in dev; adjust host in ACC/PROD if deployed separately.
MEDIA_SOURCE_ENABLED=true
MEDIA_AGGREGATOR_BASE=http://localhost:3002/v1/media-aggregator
MEDIA_AGGREGATOR_API_KEY=change-me-same-as-accept-key

# Aggregator ingestion (media-aggregator module)
# ACCEPT_KEY guards inbound /search calls; unset = open (loopback dev only).
MEDIA_AGGREGATOR_ACCEPT_KEY=change-me-long-random-secret
MEDIA_AGGREGATOR_CACHE_TTL_MS=900000
MEDIA_AGGREGATOR_SENTIMENT_ENABLED=false