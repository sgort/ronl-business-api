{
  "name": "@ronl/backend",
  "version": "2026.09.10",
  "description": "Secure Business API layer for Dutch municipality BPMN services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "edocs:health": "tsx scripts/edocs-healthcheck.ts",
    "doccle:health": "tsx scripts/doccle-healthcheck.ts",
    "pa:reset-data": "tsx scripts/reset-pa-data.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --coverage",
    "test:serial": "jest --coverage --runInBand",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "bpmn",
    "dmn",
    "keycloak",
    "operaton",
    "government",
    "api",
    "multi-tenant",
    "security"
  ],
  "author": "RONL Team",
  "license": "EUPL-1.2",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ronl/shared": "*",
    "altcha-lib": "^2.4.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "fast-xml-parser": "^5.11.1",
    "form-data": "^4.0.6",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "keycloak-connect": "^23.0.7",
    "multer": "^2.3.0",
    "node-cache": "^5.1.2",
    "openai": "^6.49.0",
    "operaton-mcp": "^1.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pg-promise": "^11.15.0",
    "redis": "^4.7.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "3.9.6",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.0.0"
  }
}
