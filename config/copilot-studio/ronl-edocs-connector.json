{
  "swagger": "2.0",
  "info": {
    "title": "RONL eDOCS",
    "description": "Read-only document management via the RONL Business API. Authenticates with a static API key and proxies operations to OpenText eDOCS DOCUVITT.",
    "version": "1.0.0"
  },
  "host": "acc.api.open-regels.nl",
  "basePath": "/v1/copilot/edocs",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "name": "X-API-Key",
      "in": "header"
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "GetEdocsStatus",
        "summary": "Get eDOCS service status",
        "description": "Returns the health of the eDOCS connection and whether stub mode is active.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service status",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["up", "down", "stub"],
                      "description": "Connection status. 'stub' means no real eDOCS server is contacted."
                    },
                    "library": {
                      "type": "string",
                      "description": "eDOCS library name, e.g. DOCUVITT"
                    },
                    "stubMode": { "type": "boolean" },
                    "latencyMs": { "type": "integer" },
                    "error": { "type": "string" }
                  }
                },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "/workspaces": {
      "get": {
        "operationId": "ListWorkspaces",
        "summary": "List eDOCS workspaces",
        "description": "Returns up to 10 workspaces from eDOCS. Useful for browsing available project containers.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of workspaces",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": {
                  "type": "array",
                  "items": { "type": "object" }
                },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            }
          },
          "502": {
            "description": "eDOCS connection error",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/workspaces/{workspaceId}/documents": {
      "get": {
        "operationId": "GetWorkspaceDocuments",
        "summary": "List documents in a workspace",
        "description": "Returns all documents stored in the given eDOCS workspace.",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "type": "string",
            "description": "eDOCS workspace ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Documents in workspace",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": {
                  "type": "object",
                  "properties": {
                    "workspaceId": { "type": "string" },
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "documentNumber": { "type": "string" }
                        }
                      }
                    }
                  }
                },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            }
          },
          "502": {
            "description": "eDOCS connection error",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/documents/{documentId}/profile": {
      "get": {
        "operationId": "GetDocumentProfile",
        "summary": "Get a document's metadata profile",
        "description": "Returns the full eDOCS metadata profile for a single document.",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "type": "string",
            "description": "eDOCS document ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Document profile",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": { "type": "object" },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            }
          },
          "502": {
            "description": "eDOCS connection error",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/documents/{documentId}/versions": {
      "get": {
        "operationId": "GetDocumentVersions",
        "summary": "List a document's version history",
        "description": "Returns the version history for a single document.",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "type": "string",
            "description": "eDOCS document ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Document versions",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": {
                  "type": "object",
                  "properties": {
                    "documentId": { "type": "string" },
                    "versions": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            }
          },
          "502": {
            "description": "eDOCS connection error",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
