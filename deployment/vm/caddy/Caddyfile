# Basic security headers (for CPRMV - no CSP)
(basic_security_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy "same-origin"
    header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    header Cross-Origin-Embedder-Policy "require-corp"
    header Cross-Origin-Opener-Policy "same-origin"
    header Cross-Origin-Resource-Policy "same-origin"
}

# Keycloak security headers (less restrictive for OAuth/OIDC)
(keycloak_security_headers) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "SAMEORIGIN"
	# Except Keycloak's third-party-cookie check: keycloak-js loads these two
	# pages in a hidden frame from the app's origin before every silent
	# check-sso, and Keycloak serves them frameable on purpose (they have no
	# UI). With SAMEORIGIN they were blocked, so the Linked Data Explorer and
	# ttl-editor could not pick up a session after the sign-in popup or on
	# reload (linked-data-explorer #163). A deletion is deferred by Caddy until
	# the response is written, so it wins over the line above.
	@kc_3p_cookies path /realms/*/protocol/openid-connect/3p-cookies/*
	header @kc_3p_cookies -X-Frame-Options
	header X-XSS-Protection "1; mode=block"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
}

# Enhanced security headers with strict CSP (for Operaton - NON-API)
(enhanced_security_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy "same-origin"
#    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    header Cross-Origin-Embedder-Policy "require-corp"
    header Cross-Origin-Opener-Policy "same-origin"
    header Cross-Origin-Resource-Policy "same-origin"
}

# Skosmos security headers — X-Frame-Options: DENY (basic_security_headers)
# blocks ALL framing, including the caseworker app and the public site that
# both need to embed the RONL thesaurus. A CSP frame-ancestors allow-list
# replaces it: only these specific origins may frame this site, everything
# else is still refused.
(skosmos_security_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Content-Type-Options "nosniff"
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy "same-origin"
    header Content-Security-Policy "frame-ancestors 'self' https://mijn.open-regels.nl https://acc.mijn.open-regels.nl https://publiek.open-regels.nl https://acc.publiek.open-regels.nl http://localhost:5173 http://localhost:5175"
    header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
}

# Updated security headers snippet for Nextcloud
(nextcloud_security_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "SAMEORIGIN"
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy "same-origin"
    header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    # Add forwarded headers for proper IP detection
    header X-Forwarded-Proto {scheme}
    header X-Forwarded-Host {host}
    header X-Real-IP {remote}
}

skosmos.open-regels.nl {
    handle /.well-known/* {
        root * /srv/static/skosmos
        file_server
    }
    handle /*.asc {
        root * /srv/static
        file_server
    }
    import skosmos_security_headers
    reverse_proxy skosmos-web:80
    encode gzip
}

nextcloud.open-regels.nl {
    # 1. CalDAV/CardDAV service discovery (uses simple redirect)
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301
    
    # 2. Webfinger/Nodeinfo service discovery (uses rewrite to index.php)
    # The trailing? is crucial to prevent Caddy from appending the query string again.
    rewrite /.well-known/webfinger /index.php/.well-known/webfinger
    rewrite /.well-known/nodeinfo /index.php/.well-known/nodeinfo

    # 3. Handle specific static files (if needed, but placed after crucial rewrites)
    handle /*.asc {
        root * /srv/static
        file_server
    }
    
    # 4. Apply headers and proxy
    import nextcloud_security_headers
    reverse_proxy host.docker.internal:8081
    encode gzip
}

operaton.open-regels.nl {
    # Handle static files
    handle /.well-known/* {
        root * /srv/static/operaton
        file_server
    }
    handle /*.asc {
        root * /srv/static
        file_server
    }
    
    # Engine REST API (#415): the rules stay public (read definitions and
    # deployments, evaluate decisions, as publicReader); everything else needs
    # the caller's own credentials. CORS only on the public paths.
    # Proven by deployment/vm/operaton/test/check-allowlist.sh.
    import operaton-engine-rest.caddy

    # Handle all other routes (Cockpit, Tasklist, etc.) with strict security
    handle {
        import enhanced_security_headers
        reverse_proxy 172.18.0.10:8080
    }
    
    encode gzip
}

