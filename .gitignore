packages/backend/*.zip

# Environment files
.env
.env.local
.env.*.local
packages/backend/.env.development
.env.production
.env.acceptance
# Backups of the above — an editor's or a script's .bak/.orig copy carries the
# same secrets as the file it shadows, and the exact-path rules above miss it.
.env*.bak*
.env*.orig
.env*.save

