# Package-manager cooldown: npm will not resolve a version published less than
# 14 days ago. ICTU recommendation 6, tracked in sgort/linked-data-explorer#119.
# npm enforces this from 11.10.0; older npm reads it and ignores it silently.
#
# Where it applies, since the move to Node 24 (npm 11.19):
# - `npm install` and `npm update` on a workstation. scripts/check-deps.sh
#   refuses below npm 11.10 at every dev-server start and push, and names
#   `nvm use`.
# - Renovate's update pull requests and lock-file maintenance. Renovate passes
#   no `--before` when this key exists and leaves the cutoff to npm. It installs
#   its npm from `engines.npm` (>=11.10.0), so that floor is the cooldown's.
#   Security pull requests pass no minimum age, by Renovate's design.
#
# The one exception: `npm ci` ignores it on purpose and installs the lockfile as
# it is (npm/cli#9281). The lockfile changes only through a pull request; the
# check that every changed version there is at least 14 days old arrives with
# the dependency register gate, ported from linked-data-explorer (its PR #368).
#
# An urgent security fix may skip the cooldown, as the guideline allows: set the
# min-release-age flag to zero days on that one command line, never in this
# file, and say why in the pull request.
min-release-age=14
